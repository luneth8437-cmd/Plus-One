DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
PLUSONE_LLM_MODEL=deepseek-v4-flash
PLUSONE_MODERATION_MODE=external
PLUSONE_MODERATION_TIMEOUT_SECONDS=5
PLUSONE_INTERACTIVE_TIMEOUT_SECONDS=8
PLUSONE_NEW_MATCHES_ENABLED=True
DJANGO_DEBUG=True
# For offline development only: PLUSONE_MODERATION_MODE=rules
# Rules mode is rejected when DEBUG=False. SDK automatic retries are disabled.

# Production only. Keep these values in the hosting dashboard, not in source control.
# Leave them commented out for local development: SECURE_SSL_REDIRECT=True breaks
# local runs and the test suite (every request 301-redirects to https).
# SECRET_KEY=your_django_secret_key
# ALLOWED_HOSTS=127.0.0.1,localhost
# CSRF_TRUSTED_ORIGINS=
# DATABASE_URL=
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
